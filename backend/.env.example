# Backend Environment Variables

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=splitpay
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority

# Set clerk after migrating legacy accounts. firebase is the rollback mode.
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTY=http://localhost:3000
# Clerk Dashboard > API keys > JWT public key (PEM, literal \n accepted)
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----

# Firebase Admin SDK, needed for rollback and the legacy migration audit
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL for CORS
CLIENT_URL=http://localhost:3000

# Optional Razorpay Test Mode only. Never use live keys here.
# Create test keys in Razorpay Dashboard > Account & Settings > API Keys.
# RAZORPAY_TEST_KEY_ID=rzp_test_replace_me
# RAZORPAY_TEST_KEY_SECRET=replace_me
# Optional: Dashboard webhook secret for payment.captured delivery to /api/webhooks/razorpay-test
# RAZORPAY_TEST_WEBHOOK_SECRET=replace_me
